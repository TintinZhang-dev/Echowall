# ============ Phewall .gitignore ============
# 依赖
node_modules/

# 数据库 & 用户数据（绝不入库）
data.db
data.db-shm
data.db-wal
data.db.bak-*
*.db.bak*

# 用户上传内容
uploads/*
!uploads/.gitkeep

# ===== 密钥 / 本地实例配置（绝不入库）=====
keystore/
.env
.env.local
ecosystem.config.cjs
site.config.json
.claude/

# 日志
*.log
debug-errors.log

# 构建产物：APK 二进制不入库（deploy.sh 走 rsync 仍会带，线上不受影响）
public/downloads/*.apk
*.apk
*.aab

# 归档 / 临时
*.tar.gz
*.zip
.DS_Store
